# Local llama.cpp OpenAI-compatible server (same layout as the existing bugloc setup)
LLAMA_SERVER=C:\llama\llama-server.exe
MODEL_PATH=C:\llama\models\gemma-4-E4B_q4_0-it.gguf
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080
LLAMA_CONTEXT=4096
LLAMA_THREADS=6
LLAMA_STARTUP_TIMEOUT=300
GEMMA_AGENT_MANAGE_LLAMA=true

# OpenAI-compatible client talking to llama-server
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=local
LLM_MODEL=gemma-4-e4b-it
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# Agent jail
GEMMA_AGENT_WORKSPACE=./workspace
GEMMA_AGENT_MAX_STEPS=24
GEMMA_AGENT_TASK_TIMEOUT=600
SHELL_TIMEOUT_SECONDS=30
TEST_TIMEOUT_SECONDS=120
MAX_OUTPUT_BYTES=200000
